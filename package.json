{
  "name": "@goodandready/dsh-approval-gate",
  "version": "0.1.32",
  "description": "Command safety gate and audit UI for DeepSeek Harness: blocks recognized dangerous operations, enforces workspace policies, and requests DSH approval when syntax cannot be verified.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "rules",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "bin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GooDAnDReaDY/dsh-approval-gate.git"
  },
  "homepage": "https://github.com/GooDAnDReaDY/dsh-approval-gate#readme",
  "bugs": {
    "url": "https://github.com/GooDAnDReaDY/dsh-approval-gate/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "eval": "node bin/eval.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "security",
    "approval-gate",
    "safety"
  ],
  "bin": {
    "dsh-approval-eval": "./bin/eval.mjs"
  },
  "packageManager": "npm@10.9.8"
}
