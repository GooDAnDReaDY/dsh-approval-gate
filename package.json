    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodandready-private/dsh-approval-gate.git"
  },
  "homepage": "https://github.com/goodandready-private/dsh-approval-gate#readme",
